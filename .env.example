# Public Firebase web config (safe to expose, security is enforced by Firebase rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server only: Firebase Admin service account JSON string (never prefix with VITE_)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Server only: model provider and access control
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ADMIN_EMAILS=admin@example.org
